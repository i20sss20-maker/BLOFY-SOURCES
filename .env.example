PORT=8080
PUBLIC_BASE_URL=https://xtream.example.com
ADMIN_PASSWORD=change-this-now
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data

# Catalog sizes. Raise gradually after deployment health is proven.
IA_LIMIT=3000
WIKIMEDIA_LIMIT=800
PEERTUBE_LIMIT=1200
NASA_LIMIT=500
IPTV_ORG_LIMIT=5000

# PeerTube instances used as discovery seeds. Only CC BY / CC BY-SA / CC0 / public-domain style licenses are accepted.
PEERTUBE_INSTANCES=https://peertube.cpy.re

# IPTV-org is a directory of publicly reachable streams, not a rights guarantee.
# Keep false until you review whether your intended use is permitted for the channels you enable.
ENABLE_IPTV_ORG=false

# Optional scheduled sync interval (milliseconds). Default: 6 hours.
SYNC_INTERVAL_MS=21600000
