PORT=8080
NODE_ENV=production

# When deployed into the existing BLOFY Azure gateway, both should be the public gateway FQDN.
PUBLIC_BASE_URL=https://blofy-gateway.example.com
XTREAM_PUBLIC_BASE_URL=https://blofy-gateway.example.com

# Existing Azure services preserved behind the unified gateway.
ACTIVATION_URL=http://blofy-activation
RELEASE_URL=http://blofy-releases

ADMIN_PASSWORD=change-this-now
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data

# Azure Blob persistence. IDENTITY_ENDPOINT and IDENTITY_HEADER are injected by Azure Container Apps.
AZURE_STORAGE_ACCOUNT=
AZURE_CLIENT_ID=
BLOFY_BLOB_CONTAINER=blofy-xtream

# Optional bootstrap account. It disappears from use once persistent accounts exist.
XTREAM_USERNAME=blofyopen
XTREAM_PASSWORD=replace-with-a-strong-player-password

# Catalog sizes.
IA_LIMIT=6000
IA_SERIES_LIMIT=2500
IA_ARABIC_LIMIT=2500
WIKIMEDIA_LIMIT=1200
WIKIMEDIA_ARABIC_LIMIT=800
PEERTUBE_LIMIT=3000
PEERTUBE_ARABIC_LIMIT=800
NASA_LIMIT=700
FREE_TV_LIMIT=4000
IPTV_ORG_LIMIT=10000

PEERTUBE_INSTANCES=https://framatube.org,https://video.tedomum.net,https://videos.domainepublic.net,https://peertube.uno,https://tube-sciences-technologies.apps.education.fr,https://indymotion.fr

ENABLE_FREE_TV=true
FREE_TV_VALIDATE_ARABIC=true
FREE_TV_VALIDATE_CONCURRENCY=12

# Disabled by default: a public stream directory is not itself a rights guarantee.
ENABLE_IPTV_ORG=false

SYNC_ON_START=true
SYNC_INTERVAL_MS=21600000
