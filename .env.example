PORT=8080
PUBLIC_BASE_URL=https://xtream.example.com
ADMIN_PASSWORD=change-this-now
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data

# Optional bootstrap Xtream account. Used only while no account has been saved in DATA_DIR/state.json.
# Resetting the account from the admin panel creates a persistent account that overrides these values.
XTREAM_USERNAME=blofyopen
XTREAM_PASSWORD=replace-with-a-strong-player-password

# Catalog sizes. Raise gradually after deployment health is proven.
IA_LIMIT=6000
WIKIMEDIA_LIMIT=1200
PEERTUBE_LIMIT=3000
NASA_LIMIT=700
FREE_TV_LIMIT=4000
IPTV_ORG_LIMIT=10000

# PeerTube discovery seeds. Every returned video is still filtered by its own machine-readable licence.
PEERTUBE_INSTANCES=https://video.sadmin.io,https://framatube.org,https://video.tedomum.net,https://videos.domainepublic.net,https://peertube.uno,https://tube-sciences-technologies.apps.education.fr,https://indymotion.fr

# Free-TV is enabled by default because its project policy only accepts channels that are free and officially available.
ENABLE_FREE_TV=true

# IPTV-org is much larger but is a directory of publicly reachable streams, not a rights guarantee.
# Keep false until you review whether your intended use is permitted for the channels you enable.
ENABLE_IPTV_ORG=false

# Refresh the catalog in the background after each service start so new providers/config limits apply immediately.
SYNC_ON_START=true

# Optional scheduled sync interval (milliseconds). Default: 6 hours.
SYNC_INTERVAL_MS=21600000
