PORT=8080
NODE_ENV=production

PUBLIC_BASE_URL=https://blofy-gateway.example.com
XTREAM_PUBLIC_BASE_URL=https://blofy-gateway.example.com

ACTIVATION_URL=http://blofy-activation
RELEASE_URL=http://blofy-releases

ADMIN_PASSWORD=change-this-now
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data

AZURE_STORAGE_ACCOUNT=
AZURE_CLIENT_ID=
BLOFY_BLOB_CONTAINER=blofy-xtream

XTREAM_USERNAME=blofyopen
XTREAM_PASSWORD=replace-with-a-strong-player-password

# Large catalog defaults. Every provider still applies its rights/source filters.
IA_LIMIT=14000
IA_SERIES_LIMIT=4500
IA_ARABIC_LIMIT=4500
IA_FEDFLIX_LIMIT=6000
IA_PRELINGER_LIMIT=5000
IA_PAGE_CONCURRENCY=3

WIKIMEDIA_LIMIT=2500
WIKIMEDIA_ARABIC_LIMIT=1500

PEERTUBE_LIMIT=6000
PEERTUBE_ARABIC_LIMIT=1500
PEERTUBE_INSTANCES=https://framatube.org,https://video.tedomum.net,https://videos.domainepublic.net,https://tube-sciences-technologies.apps.education.fr,https://indymotion.fr
PEERTUBE_SEED_CONCURRENCY=3

NASA_LIMIT=700
FREE_TV_LIMIT=4000
IPTV_ORG_LIMIT=10000

ENABLE_FREE_TV=true
FREE_TV_VALIDATE_ARABIC=true
FREE_TV_VALIDATE_CONCURRENCY=12

ENABLE_IPTV_ORG=false

SYNC_ON_START=true
SYNC_INTERVAL_MS=21600000
SYNC_PROVIDER_CONCURRENCY=3
